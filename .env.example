# =============================================================================
# .env.example — OCR Benchmark Framework
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Label Studio
# -----------------------------------------------------------------------------
# Admin credentials for the Label Studio UI
LABEL_STUDIO_USERNAME=admin@ocr.local
LABEL_STUDIO_PASSWORD=changeme

# API key from Label Studio → Account → Access Token
# Used by score.py / export_results.py to pull annotation data
LABEL_STUDIO_API_KEY=

# Label Studio project ID to use when exporting annotations
LABEL_STUDIO_PROJECT_ID=1

# -----------------------------------------------------------------------------
# OCR Service
# -----------------------------------------------------------------------------
# Override the config.yaml path inside the container
CONFIG_PATH=/workspace/configs/config.yaml

# Paddle model download directory (maps to Docker volume)
PADDLE_MODEL_DIR=/paddle-models

# Directory paths inside the container
OCR_LOG_DIR=/logs
OCR_RESULTS_DIR=/results
OCR_REPORTS_DIR=/reports
OCR_IMAGES_DIR=/workspace/images
OCR_ANNOTATIONS_DIR=/workspace/annotations
OCR_OUTPUT_DIR=/workspace/ocr_output

# -----------------------------------------------------------------------------
# Optional: Proxy (if running behind corporate proxy)
# -----------------------------------------------------------------------------
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,labelstudio
